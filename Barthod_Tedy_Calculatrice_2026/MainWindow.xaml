<Window x:Class="Barthod_Tedy_Calculatrice_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Barthod_Tedy_Calculatrice_2026"
        mc:Ignorable="d"
        Title="Calculatrice" Height="670" Width="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#D6EADF">

    <!-- Calculatrice WPF - Tedy Barthod - BTS CIEL 1
         Ce fichier fait l'apparence de la calculatrice -->

    <Grid>

        <Grid.Resources>

            <!-- Style de tous les boutons.
                 Les boutons qui ne sont pas des chiffres changent juste leur couleur avec Background -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="6"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#2B2B3A"/>
                <Setter Property="Background" Value="#95B8D1"/>

                <!-- Boutons avec les coins arrondis -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="15"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>

                    <!-- Souris sur le bouton : il devient un peu transparent -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8"/>
                    </Trigger>

                    <!-- Clic : le bouton flashe en blanc -->
                    <EventTrigger RoutedEvent="Click">
                        <EventTrigger.Actions>
                            <BeginStoryboard>
                                <Storyboard BeginTime="00:00:00" AutoReverse="True">
                                    <ColorAnimation
                                        Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                        To="WhiteSmoke"
                                        Duration="0:0:0.05"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger.Actions>
                    </EventTrigger>

                </Style.Triggers>
            </Style>

            <!-- Écran : le nombre est écrit en bas à droite -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="18,10,18,14"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="Foreground" Value="#2B2B3A"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Bottom"/>
            </Style>

        </Grid.Resources>

        <!-- 4 colonnes -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 7 lignes : l'écran, la mémoire, puis 5 lignes de boutons -->
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cadre de l'écran -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Margin="10"
                CornerRadius="12" Background="#F7FBF9"
                BorderBrush="#809BCE" BorderThickness="2"/>

        <!-- Écran : on écrit avec les boutons ou au clavier -->
        <TextBox Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Display"/>

        <!-- Petit M en haut à gauche quand la mémoire est utilisée -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Memoire"
                   FontSize="16" FontWeight="Bold" Foreground="#4F6BA8"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="24,18,0,0"/>

        <!-- Rappel du calcul en haut à droite (ex : 12 +) -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Expression"
                   FontSize="16" Foreground="#4F6BA8"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,18,24,0"/>

        <!-- Mémoire : boutons plus petits et sans fond -->
        <Button Grid.Row="1" Grid.Column="0" Name="BTN_MC" Content="MC" Margin="6,2" FontSize="16" Foreground="#4F6BA8" Background="#00FFFFFF" Click="BTN_MC_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Name="BTN_MR" Content="MR" Margin="6,2" FontSize="16" Foreground="#4F6BA8" Background="#00FFFFFF" Click="BTN_MR_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Name="BTN_MPlus" Content="M+" Margin="6,2" FontSize="16" Foreground="#4F6BA8" Background="#00FFFFFF" Click="BTN_MPlus_Click"/>
        <Button Grid.Row="1" Grid.Column="3" Name="BTN_MMoins" Content="M-" Margin="6,2" FontSize="16" Foreground="#4F6BA8" Background="#00FFFFFF" Click="BTN_MMoins_Click"/>

        <!-- 1 2 3 + -->
        <Button Grid.Row="2" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Name="BTN_Plus" Content="+" Background="#809BCE" Click="BTN_Plus_Click"/>

        <!-- 4 5 6 - -->
        <Button Grid.Row="3" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click"/>
        <Button Grid.Row="3" Grid.Column="3" Name="BTN_Moins" Content="-" Background="#809BCE" Click="BTN_Moins_Click"/>

        <!-- 7 8 9 * -->
        <Button Grid.Row="4" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click"/>
        <Button Grid.Row="4" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click"/>
        <Button Grid.Row="4" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click"/>
        <Button Grid.Row="4" Grid.Column="3" Name="BTN_Fois" Content="*" Background="#809BCE" Click="BTN_Fois_Click"/>

        <!-- 0 C = / -->
        <Button Grid.Row="5" Grid.Column="0" Name="BTN_0" Content="0" Click="BTN_0_Click"/>
        <Button Grid.Row="5" Grid.Column="1" Name="BTN_C" Content="C" Background="#EAC4D5" Click="BTN_C_Click"/>
        <Button Grid.Row="5" Grid.Column="2" Name="BTN_Egal" Content="=" Background="#B8E0D2" Click="BTN_Egal_Click"/>
        <Button Grid.Row="5" Grid.Column="3" Name="BTN_Divise" Content="/" Background="#809BCE" Click="BTN_Divise_Click"/>

        <!-- +/- % racine , -->
        <Button Grid.Row="6" Grid.Column="0" Name="BTN_Signe" Content="+/-" FontSize="22" Background="#F7FBF9" Click="BTN_Signe_Click"/>
        <Button Grid.Row="6" Grid.Column="1" Name="BTN_Pourcent" Content="%" Background="#F7FBF9" Click="BTN_Pourcent_Click"/>
        <Button Grid.Row="6" Grid.Column="2" Name="BTN_Racine" Content="√" Background="#F7FBF9" Click="BTN_Racine_Click"/>
        <Button Grid.Row="6" Grid.Column="3" Name="BTN_Virgule" Content="," Click="BTN_Virgule_Click"/>

    </Grid>
</Window>

<Window x:Class="Barthod_Tedy_Calculatrice_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Barthod_Tedy_Calculatrice_2026"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>

        <!-- ===== Style commun pour TOUS les boutons ===== -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Coins arrondis via ControlTemplate -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- Survol de la souris -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A5A5A"/>
                </Trigger>

                <!-- Petit flash au clic -->
                <EventTrigger RoutedEvent="Click">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                    To="WhiteSmoke"
                                    Duration="0:0:0.08"
                                    AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Style pour les boutons opérateurs (+ - * /) ===== -->
        <Style x:Key="OperateurStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF9500"/>
        </Style>

        <!-- ===== Style pour le bouton égale ===== -->
        <Style x:Key="EgaleStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#34C759"/>
        </Style>

        <!-- ===== Style pour le bouton ctrl / clear ===== -->
        <Style x:Key="CtrlStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF3B30"/>
        </Style>

        <!-- ===== Style de la TextBox d'affichage ===== -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Écran d'affichage -->
        <TextBox Grid.Row="0" Grid.ColumnSpan="4"
                  Name="TB_Display"
                  TextChanged="TB_Display_TextChanged"/>

        <!-- Ligne 1 -->
        <Button Grid.Row="1" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click"/>
        <Button Grid.Row="1" Grid.Column="3" Name="BTN_Plus" Content="+" Style="{StaticResource OperateurStyle}" Click="BTN_Plus_Click"/>

        <!-- Ligne 2 -->
        <Button Grid.Row="2" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Name="BTN_Moin" Content="-" Style="{StaticResource OperateurStyle}" Click="BTN_Moin_Click"/>

        <!-- Ligne 3 -->
        <Button Grid.Row="3" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click"/>
        <Button Grid.Row="3" Grid.Column="3" Name="BTN_Multipliee" Content="*" Style="{StaticResource OperateurStyle}" Click="BTN_Multipliee_Click"/>

        <!-- Ligne 4 -->
        <Button Grid.Row="4" Grid.Column="0" Name="Btn_0" Content="0" Click="Btn_0_Click"/>
        <Button Grid.Row="4" Grid.Column="1" Name="Btn_Ctrl" Content="C" Style="{StaticResource CtrlStyle}" Click="Btn_Ctrl_Click"/>
        <Button Grid.Row="4" Grid.Column="2" Name="Btn_egale" Content="=" Style="{StaticResource EgaleStyle}" Click="Btn_egale_Click"/>
        <Button Grid.Row="4" Grid.Column="3" Name="Btn_divisée" Content="/" Style="{StaticResource OperateurStyle}" Click="Btn_divisée_Click"/>

    </Grid>
</Window>

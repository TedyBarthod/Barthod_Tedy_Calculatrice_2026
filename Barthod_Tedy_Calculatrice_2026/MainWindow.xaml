<Window x:Class="Barthod_Tedy_Calculatrice_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Barthod_Tedy_Calculatrice_2026"
        mc:Ignorable="d"
        Title="Calculatrice" Height="670" Width="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#D6EADF">

    <!-- ====================================================================
         Projet  : Calculatrice WPF (TP BTS CIEL 1)
         Auteur  : Tedy Barthod
         Fichier : MainWindow.xaml
         Rôle    : apparence de la calculatrice (la logique est dans le .xaml.cs)
         ==================================================================== -->

    <Grid>

        <!-- ===================== Styles ===================== -->
        <Grid.Resources>

            <!-- Style de tous les boutons : c'est celui des chiffres -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="6"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#2B2B3A"/>
                <Setter Property="Background" Value="#95B8D1"/>

                <!-- Coins arrondis : on redessine le bouton avec un Border -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="15"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>

                    <!-- Quand la souris passe sur le bouton -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8"/>
                    </Trigger>

                    <!-- Quand on clique : la couleur passe vite au blanc puis revient -->
                    <EventTrigger RoutedEvent="Click">
                        <EventTrigger.Actions>
                            <BeginStoryboard>
                                <Storyboard BeginTime="00:00:00" AutoReverse="True">
                                    <ColorAnimation
                                        Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                        To="WhiteSmoke"
                                        Duration="0:0:0.05"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger.Actions>
                    </EventTrigger>

                </Style.Triggers>
            </Style>

            <!-- Les styles suivants reprennent le style des boutons (BasedOn)
                 et changent seulement ce qui est différent -->

            <!-- Opérateurs : +  -  *  / -->
            <Style x:Key="OperateurStyle" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#809BCE"/>
            </Style>

            <!-- Égal -->
            <Style x:Key="EgalStyle" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#B8E0D2"/>
            </Style>

            <!-- Effacer : C -->
            <Style x:Key="EffacerStyle" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#EAC4D5"/>
            </Style>

            <!-- Fonctions : signe, pourcentage, racine -->
            <Style x:Key="FonctionStyle" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#F7FBF9"/>
            </Style>

            <!-- Mémoire : boutons discrets, sans fond -->
            <Style x:Key="MemoireStyle" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="6,2"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="#4F6BA8"/>
                <Setter Property="Background" Value="#00FFFFFF"/>
            </Style>

            <!-- Écran : le nombre s'écrit en bas à droite -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="18,10,18,14"/>
                <Setter Property="FontSize" Value="34"/>
                <Setter Property="Foreground" Value="#2B2B3A"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Bottom"/>
            </Style>

        </Grid.Resources>

        <!-- ===================== Grille : 4 colonnes, 7 lignes ===================== -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>   <!-- ligne 0 : écran -->
            <RowDefinition Height="45"/>    <!-- ligne 1 : mémoire -->
            <RowDefinition Height="*"/>     <!-- lignes 2 à 6 : boutons -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Écran ===================== -->

        <!-- Cadre arrondi de l'écran -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Margin="10"
                CornerRadius="12" Background="#F7FBF9"
                BorderBrush="#809BCE" BorderThickness="2"/>

        <!-- Le nombre. IsReadOnly : on écrit seulement avec les boutons,
             donc l'écran ne peut pas contenir de texte invalide -->
        <TextBox Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Display" IsReadOnly="True"/>

        <!-- Petit "M" en haut à gauche : vide au départ, le C# y écrit "M" -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Memoire"
                   FontSize="16" FontWeight="Bold" Foreground="#4F6BA8"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="24,18,0,0"/>

        <!-- Rappel du calcul en haut à droite, par exemple "12 +" -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Expression"
                   FontSize="16" Foreground="#4F6BA8"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,18,24,0"/>

        <!-- ===================== Boutons ===================== -->

        <!-- Ligne 1 : mémoire -->
        <Button Grid.Row="1" Grid.Column="0" Name="BTN_MC" Content="MC" Style="{StaticResource MemoireStyle}" Click="BTN_MC_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Name="BTN_MR" Content="MR" Style="{StaticResource MemoireStyle}" Click="BTN_MR_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Name="BTN_MPlus" Content="M+" Style="{StaticResource MemoireStyle}" Click="BTN_MPlus_Click"/>
        <Button Grid.Row="1" Grid.Column="3" Name="BTN_MMoins" Content="M-" Style="{StaticResource MemoireStyle}" Click="BTN_MMoins_Click"/>

        <!-- Ligne 2 -->
        <Button Grid.Row="2" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Name="BTN_Plus" Content="+" Style="{StaticResource OperateurStyle}" Click="BTN_Plus_Click"/>

        <!-- Ligne 3 -->
        <Button Grid.Row="3" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click"/>
        <Button Grid.Row="3" Grid.Column="3" Name="BTN_Moins" Content="-" Style="{StaticResource OperateurStyle}" Click="BTN_Moins_Click"/>

        <!-- Ligne 4 -->
        <Button Grid.Row="4" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click"/>
        <Button Grid.Row="4" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click"/>
        <Button Grid.Row="4" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click"/>
        <Button Grid.Row="4" Grid.Column="3" Name="BTN_Fois" Content="*" Style="{StaticResource OperateurStyle}" Click="BTN_Fois_Click"/>

        <!-- Ligne 5 -->
        <Button Grid.Row="5" Grid.Column="0" Name="BTN_0" Content="0" Click="BTN_0_Click"/>
        <Button Grid.Row="5" Grid.Column="1" Name="BTN_C" Content="C" Style="{StaticResource EffacerStyle}" Click="BTN_C_Click"/>
        <Button Grid.Row="5" Grid.Column="2" Name="BTN_Egal" Content="=" Style="{StaticResource EgalStyle}" Click="BTN_Egal_Click"/>
        <Button Grid.Row="5" Grid.Column="3" Name="BTN_Divise" Content="/" Style="{StaticResource OperateurStyle}" Click="BTN_Divise_Click"/>

        <!-- Ligne 6 -->
        <Button Grid.Row="6" Grid.Column="0" Name="BTN_Signe" Content="+/-" FontSize="22" Style="{StaticResource FonctionStyle}" Click="BTN_Signe_Click"/>
        <Button Grid.Row="6" Grid.Column="1" Name="BTN_Pourcent" Content="%" Style="{StaticResource FonctionStyle}" Click="BTN_Pourcent_Click"/>
        <Button Grid.Row="6" Grid.Column="2" Name="BTN_Racine" Content="√" Style="{StaticResource FonctionStyle}" Click="BTN_Racine_Click"/>
        <Button Grid.Row="6" Grid.Column="3" Name="BTN_Virgule" Content="," Click="BTN_Virgule_Click"/>

    </Grid>
</Window>

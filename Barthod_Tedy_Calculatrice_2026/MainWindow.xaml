<Window x:Class="Barthod_Tedy_Calculatrice_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Barthod_Tedy_Calculatrice_2026"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Display" TextChanged="TB_Display_TextChanged"></TextBox>

        <Button Grid.Row="1" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click"/>
        <Button Grid.Row="1" Grid.Column="3" Name="BTN_Plus" Content="+" Click="BTN_Plus_Click"/>

        <Button Grid.Row="2" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Name="BTN_Moin" Content="-" Click="BTN_Moin_Click"/>

        <Button Grid.Row="3" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click"/>
        <Button Grid.Row="3" Grid.Column="3" Name="BTN_Multipliee" Content="*" Click="BTN_Multipliee_Click"/>

        <Button Grid.Row="4" Grid.Column="0" Name="Btn_0" Content="0" Click="Btn_0_Click"/>
        <Button Grid.Row="4" Grid.Column="1" Name="Btn_Ctrl" Content="ctrl"/>
        <Button Grid.Row="4" Grid.Column="2" Name="Btn_egale" Content="=" Click="Btn_egale_Click"/>
        <Button Grid.Row="4" Grid.Column="3" Name="Btn_divisée" Content="/" Click="Btn_divisée_Click"/>

        <Grid.Resources>

            <!-- Style de tous les boutons -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Background" Value="BlueViolet"/>
                <Setter Property="FontSize" Value="38"/>

                <!-- AJOUT DES TRIGGERS -->
                <Style.Triggers>

                    <!-- Quand la souris passe sur le bouton -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="DarkGray"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>

                    <!-- Quand on clique sur le bouton -->
                    <EventTrigger RoutedEvent="Click">
                        <EventTrigger.Actions>

                            <BeginStoryboard>
                                <Storyboard BeginTime="00:00:00"
                                            AutoReverse="True">

                                    <Storyboard.TargetProperty>
                                        (Button.Background).(SolidColorBrush.Color)
                                    </Storyboard.TargetProperty>

                                    <ColorAnimation To="WhiteSmoke"
                                                    Duration="0:0:0.05"/>

                                </Storyboard>
                            </BeginStoryboard>

                        </EventTrigger.Actions>
                    </EventTrigger>

                </Style.Triggers>
            </Style>


            <!-- Ton deuxième style reste inchangé -->
            <Style x:Key="MyStyle" TargetType="{x:Type Control}">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Background" Value="Green"/>
                <Setter Property="FontSize" Value="38"/>
            </Style>


            <!-- Style de la TextBox -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="FontSize" Value="38"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>

                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Style.Resources>

            </Style>

        </Grid.Resources>

    </Grid>

</Window>
